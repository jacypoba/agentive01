# Copy these into .env.local (create the file in the project root)
# Use the project URL only — do NOT append /rest/v1 or other paths.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# WhatsApp provider (production: Meta Cloud API)
WHATSAPP_PROVIDER=meta
WHATSAPP_FALLBACK_EVOLUTION=true
WHATSAPP_HEALTH_TEST_NUMBER=393479896685

# Meta WhatsApp Cloud API (primary)
META_WHATSAPP_ACCESS_TOKEN=your-meta-system-user-or-permanent-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
META_WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
META_WHATSAPP_APP_SECRET=your-meta-app-secret
META_GRAPH_API_VERSION=v21.0

# Meta webhook URL (configure in Meta Developer Console):
# GET/POST https://your-app.vercel.app/api/webhooks/meta

# Evolution API (temporary fallback only — Baileys)
EVOLUTION_API_URL=https://your-evolution-server.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=your-instance-name
EVOLUTION_WEBHOOK_SECRET=optional-webhook-secret

# Auth user UUID that owns incoming WhatsApp leads (Supabase → Authentication → Users)
WHATSAPP_DEFAULT_USER_ID=your-user-uuid

# Multi-tenant WhatsApp routing (production):
# Insert rows into workspace_whatsapp_connections via Supabase admin/SQL:
#   provider='meta', provider_instance_id=<META_WHATSAPP_PHONE_NUMBER_ID>, workspace_id, default_user_id
# WHATSAPP_DEFAULT_USER_ID is fallback only when no connection row exists.

# Cron job auth for /api/cron/follow-ups (Vercel Cron sends Bearer token)
# Cron / operational endpoints (Authorization: Bearer <secret> or x-cron-secret header)
CRON_SECRET=your-random-cron-secret

# Manual test endpoint: GET /api/test/follow-ups (same Bearer auth as cron)
# Processes ALL pending follow-ups immediately — for debugging only.

# Google Calendar (visit scheduling)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase migrations required for Google Calendar profile save:
# 007_google_calendar.sql, 010_profiles_rls_fix.sql (run in SQL Editor)
